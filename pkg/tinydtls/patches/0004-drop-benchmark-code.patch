diff --git a/peer.c b/peer.c
index bf06fae..cae30a7 100644
--- a/peer.c
+++ b/peer.c
@@ -15,6 +15,10 @@
  *
  *******************************************************************************/
 
+#if MEMORY_BENCHMARK
+extern void heap_stats(void);
+#endif
+
 #include "global.h"
 #include "peer.h"
 #include "dtls_debug.h"
@@ -26,7 +30,14 @@ void peer_init(void)
 
 static inline dtls_peer_t *
 dtls_malloc_peer(void) {
-  return (dtls_peer_t *)malloc(sizeof(dtls_peer_t));
+
+  dtls_peer_t *peer = (dtls_peer_t *)malloc(sizeof(dtls_peer_t));
+
+#if MEMORY_BENCHMARK
+  heap_stats();
+#endif
+
+  return peer;
 }
 
 void
@@ -90,6 +101,7 @@ dtls_new_peer(const session_t *session) {
   dtls_peer_t *peer;
 
   peer = dtls_malloc_peer();
+
   if (peer) {
     memset(peer, 0, sizeof(dtls_peer_t));
     memcpy(&peer->session, session, sizeof(session_t));
diff --git a/session.c b/session.c
index dea8990..55f2ec6 100644
--- a/session.c
+++ b/session.c
@@ -14,6 +14,10 @@
  *
  *******************************************************************************/
 
+#if MEMORY_BENCHMARK
+extern void heap_stats(void);
+#endif
+
 #include "session.h"
 
 #ifdef HAVE_ASSERT_H
@@ -104,6 +108,11 @@ dtls_new_session(struct sockaddr *addr, socklen_t addrlen) {
   session_t *sess;
 
   sess = malloc(sizeof(session_t));
+
+#if MEMORY_BENCHMARK
+  heap_stats();
+#endif
+
   if (!sess)
     return NULL;
   dtls_session_init(sess);
