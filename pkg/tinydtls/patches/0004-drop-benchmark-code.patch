From: HendrikVE <hendrik1995@msn.com>
Date: Fri, 6 May 2022 23:07:51 +0200
Subject: [PATCH] drop! benchmark code

---
 crypto.c  | 22 ++++++++++++++++++++--
 dtls.c    | 13 ++++++++++++-
 hmac.c    | 13 ++++++++++++-
 netq.c    | 22 ++++++++++++++++++++--
 peer.c    | 14 +++++++++++++-
 session.c |  9 +++++++++
 6 files changed, 86 insertions(+), 7 deletions(-)

diff --git a/crypto.c b/crypto.c
index 43d3079..a119aba 100644
--- a/crypto.c
+++ b/crypto.c
@@ -15,6 +15,10 @@
  *
  *******************************************************************************/
 
+#if MEMORY_BENCHMARK
+extern void heap_stats(void);
+#endif
+
 #include <stdio.h>
 
 #include "tinydtls.h"
@@ -75,7 +79,14 @@ void crypto_init(void)
 }
 
 static dtls_handshake_parameters_t *dtls_handshake_malloc(void) {
-  return malloc(sizeof(dtls_handshake_parameters_t));
+
+  dtls_handshake_parameters_t *params = malloc(sizeof(dtls_handshake_parameters_t));
+
+#if MEMORY_BENCHMARK
+  heap_stats();
+#endif
+
+  return params;
 }
 
 static void dtls_handshake_dealloc(dtls_handshake_parameters_t *handshake) {
@@ -83,7 +94,14 @@ static void dtls_handshake_dealloc(dtls_handshake_parameters_t *handshake) {
 }
 
 static dtls_security_parameters_t *dtls_security_malloc(void) {
-  return malloc(sizeof(dtls_security_parameters_t));
+
+  dtls_security_parameters_t *params = malloc(sizeof(dtls_security_parameters_t));
+
+#if MEMORY_BENCHMARK
+  heap_stats();
+#endif
+
+  return params;
 }
 
 static void dtls_security_dealloc(dtls_security_parameters_t *security) {
diff --git a/dtls.c b/dtls.c
index 507a23b..3d7f251 100644
--- a/dtls.c
+++ b/dtls.c
@@ -17,6 +17,10 @@
  *
  *******************************************************************************/
 
+#if MEMORY_BENCHMARK
+extern void heap_stats(void);
+#endif
+
 #include "tinydtls.h"
 #include "dtls_time.h"
 
@@ -204,7 +208,14 @@ static inline void free_context(dtls_context_t *context) {
 
 static inline dtls_context_t *
 malloc_context(void) {
-  return (dtls_context_t *)malloc(sizeof(dtls_context_t));
+
+  dtls_context_t *ctx = (dtls_context_t *)malloc(sizeof(dtls_context_t));
+
+#if MEMORY_BENCHMARK
+  heap_stats();
+#endif
+
+  return ctx;
 }
 
