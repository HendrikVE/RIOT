 static inline void
@@ -48,7 +59,14 @@ MEMB(netq_storage, netq_t, NETQ_MAXCNT);
 
 static inline netq_t *
 netq_malloc_node(size_t size) {
-  return (netq_t *)memb_alloc(&netq_storage);
+
+  netq_t *netq = (netq_t *)memb_alloc(&netq_storage);
