diff --git a/netq.c b/netq.c
index 06754f7..0bb5e7f 100644
--- a/netq.c
+++ b/netq.c
@@ -15,6 +15,10 @@
  *
  *******************************************************************************/
 
+#if MEMORY_BENCHMARK
